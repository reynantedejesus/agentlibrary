# /etc/systemd/system/agentlibrary.socket   (OPTIONAL)
#
# Socket activation. Use this only if you want systemd to own the socket's
# lifecycle and permissions rather than gunicorn. If you enable it, set
# GUNICORN_BIND=fd://3 in the environment file and enable the socket instead of
# the service:
#
#   sudo systemctl enable --now agentlibrary.socket
#
# The default deployment does NOT need this — gunicorn binds 127.0.0.1:8090
# and nginx proxies to that.

[Unit]
Description=Agent Library gunicorn socket

[Socket]
ListenStream=/run/agentlibrary/agentlibrary.sock
SocketUser=agentlibrary
SocketGroup=agentlibrary
SocketMode=0660

[Install]
WantedBy=sockets.target
