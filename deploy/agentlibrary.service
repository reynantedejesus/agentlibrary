# /etc/systemd/system/agentlibrary.service
#
# Runs gunicorn under a dedicated non-root account, on the loopback address
# only (127.0.0.1:8090 by default) with nginx proxying to it. Install with:
#
#   sudo install -m 0644 deploy/agentlibrary.service /etc/systemd/system/
#   sudo install -m 0644 deploy/agentlibrary.socket  /etc/systemd/system/   # optional
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agentlibrary
#
# Inspect it with:
#   systemctl status agentlibrary
#   journalctl -u agentlibrary -f              # follow live
#   journalctl -u agentlibrary -n 200 --no-pager
#   journalctl -u agentlibrary --since "10 min ago" -p err

[Unit]
Description=Agent Library (Wings Global Travel) — Gunicorn
Documentation=file:/var/www/agentlibrary/README.md
After=network-online.target mariadb.service mysqld.service
Wants=network-online.target

[Service]
Type=notify
User=agentlibrary
Group=agentlibrary
# Only matters if GUNICORN_BIND is switched to a Unix socket: nginx runs as
# its own user, and adding it to the agentlibrary group lets it connect to the
# 0660 socket without opening it to the world.
UMask=0007

WorkingDirectory=/var/www/agentlibrary

# All configuration and secrets live here — root-owned, group-readable by the
# service account, mode 0640. Nothing sensitive is in the unit file itself.
EnvironmentFile=/etc/agentlibrary/agentlibrary.env
Environment="PATH=/var/www/agentlibrary/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"

# /run/agentlibrary is created on every start and removed on stop. Unused on
# the default TCP bind, but it means switching GUNICORN_BIND to a Unix socket
# needs no other change — and no stale socket can linger after a crash.
RuntimeDirectory=agentlibrary
RuntimeDirectoryMode=0750
StateDirectory=agentlibrary
StateDirectoryMode=0750
LogsDirectory=agentlibrary
LogsDirectoryMode=0750

ExecStartPre=/var/www/agentlibrary/.venv/bin/python -c "import app; app.create_app()"
ExecStart=/var/www/agentlibrary/.venv/bin/gunicorn \
    --config /var/www/agentlibrary/gunicorn.conf.py \
    wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID

# Graceful shutdown: SIGTERM lets gunicorn finish in-flight requests, and
# TimeoutStopSec must exceed gunicorn's graceful_timeout (30s) so systemd does
# not SIGKILL a worker mid-request.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45
TimeoutStartSec=60

Restart=always
RestartSec=5
# Give up only if it fails repeatedly in a short window, so a bad config does
# not spin forever.
StartLimitIntervalSec=300
StartLimitBurst=5

# ---- hardening -------------------------------------------------------------
# The service needs to read its code, write uploads and logs, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
# AF_INET is required for the loopback bind (and for MySQL over TCP).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

# ProtectSystem=strict makes everything read-only; these are the only writable
# paths. RuntimeDirectory/StateDirectory/LogsDirectory are writable implicitly.
ReadWritePaths=/var/lib/agentlibrary /var/log/agentlibrary

# ---- resource limits -------------------------------------------------------
LimitNOFILE=8192
TasksMax=256

[Install]
WantedBy=multi-user.target
