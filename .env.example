# =============================================================================
# Agent Library — environment template
# -----------------------------------------------------------------------------
# DEVELOPMENT: copy to `.env` (git-ignored) and fill in. app/__init__.py loads
#              it automatically, but ONLY when FLASK_ENV is development/testing.
#
# PRODUCTION:  do NOT ship a .env file. Put these values in
#              /etc/agentlibrary/agentlibrary.env, owned root:agentlibrary,
#              mode 0640, and reference it from the systemd unit with
#              EnvironmentFile=. A .env file is never read in production.
#
#              That path is ALSO loaded by the application and by
#              gunicorn.conf.py, so `gunicorn ...` and `flask db upgrade` run
#              by hand behave the same as `systemctl start agentlibrary`.
#              Nothing already set in the environment is overwritten.
#              Set ENV_FILE=/path/to/other.env to use a different file.
#
# QUOTING:     quote any value containing a space or a '#', so that systemd
#              and the application's parser agree:
#                  MYSQL_PASSWORD="p@ss word#1"
#
# This file contains NO real secrets and is safe to commit.
# =============================================================================

# --- core --------------------------------------------------------------------
# development | production | testing
FLASK_ENV=development

# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app REFUSES to start in production without this.
SECRET_KEY=replace-me-with-a-long-random-value

LOG_LEVEL=INFO
LOG_DIR=/var/log/agentlibrary
LOG_TO_STDOUT=1

# --- database ----------------------------------------------------------------
# Either set DATABASE_URL directly...
# DATABASE_URL=mysql+pymysql://agentlibrary:CHANGE_ME@127.0.0.1:3306/agentlibrary?charset=utf8mb4
# ...or leave it blank and let the parts below assemble it.
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agentlibrary
MYSQL_USER=agentlibrary
MYSQL_PASSWORD=replace-me

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Must stay below MySQL's wait_timeout (default 28800) — 280s is safe.
DB_POOL_RECYCLE=280

# --- sessions & cookies ------------------------------------------------------
SESSION_COOKIE_NAME=agentlibrary_session
# MUST be 1 in production (requires HTTPS). 0 only for local http development.
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=43200
WTF_CSRF_SSL_STRICT=1

# --- uploads -----------------------------------------------------------------
# Must be OUTSIDE the static directory and outside anything nginx serves.
UPLOAD_DIR=/var/lib/agentlibrary/uploads
# Bytes. Keep nginx's client_max_body_size consistent with this (25 MiB here).
MAX_CONTENT_LENGTH=26214400
MAX_FILES_PER_ASSET=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,md,txt,docx,zip,json,yaml,yml,csv,xlsx,png,jpg,jpeg

# --- malware scanning --------------------------------------------------------
# 1 requires a reachable clamd; uploads are refused if the scanner is down.
CLAMAV_ENABLED=0
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# --- request hardening -------------------------------------------------------
# Comma-separated hostnames this app answers to. Empty disables the check.
TRUSTED_HOSTS=agentlibrary.wingsglobaltravel.com
PROXY_FIX_ENABLED=1
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
# Leave 0 when nginx already redirects http -> https.
FORCE_HTTPS_REDIRECT=0

# --- rate limiting -----------------------------------------------------------
RATELIMIT_ENABLED=1
# memory:// is per-worker. With more than one gunicorn worker use Redis:
#   RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=600 per hour
RATELIMIT_LOGIN=10 per minute;60 per hour
RATELIMIT_WRITE=60 per minute

# --- application policy ------------------------------------------------------
# 1 requires a session even to browse the approved catalogue.
REQUIRE_LOGIN_TO_BROWSE=0
# Restrict owner emails to these domains. Empty allows any valid address.
ALLOWED_EMAIL_DOMAINS=
MIN_PASSWORD_LENGTH=12
MAX_LOGIN_FAILURES=8
LOGIN_LOCKOUT_SECONDS=900
DEFAULT_PAGE_SIZE=48
MAX_PAGE_SIZE=200
MAX_TAGS_PER_ASSET=4

# --- gunicorn (read by gunicorn.conf.py) -------------------------------------
# Loopback only — nginx proxies to this. Never 0.0.0.0; gunicorn.conf.py
# refuses to start on a public interface. A Unix socket also works:
#   GUNICORN_BIND=unix:/run/agentlibrary/agentlibrary.sock
GUNICORN_BIND=127.0.0.1:8090
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info

# --- initial admin -----------------------------------------------------------
# ONLY set this temporarily for a non-interactive `flask create-admin` run, then
# REMOVE it from the environment file. Prefer the interactive prompt.
# ADMIN_INITIAL_PASSWORD=
